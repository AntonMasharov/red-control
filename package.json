{
  "name": "red-control",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/fixture-catalog-loader.mjs --test tests/*.test.mjs",
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check:content": "node scripts/build-content.mjs --check",
    "check:example": "node scripts/verify-authoring-example.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "build:content": "node scripts/build-content.mjs",
    "prebuild:web": "npm run build:content",
    "prestart": "npm run build:content",
    "test:integration": "jest --runInBand",
    "test:all": "npm test && npm run test:integration",
    "test:e2e": "cypress run",
    "preweb": "npm run build:content",
    "preandroid": "npm run build:content",
    "preios": "npm run build:content",
    "build:mobile": "expo export --platform android --platform ios --output-dir dist-native",
    "prebuild:mobile": "npm run build:content"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "react-native-markdown-display": {
      "markdown-it": "^15.0.2"
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "cypress": "^16.1.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2",
    "yaml": "^2.9.1"
  }
}
